generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  guest
  user
  employee
  admin
}

enum Gender {
  male
  female
  other
}

/// Who may book a service. `unisex` is open to every client.
enum ServiceAudience {
  male
  female
  unisex
}

enum BookingStatus {
  confirmed
  pending
  cancelled
  completed
}

enum WaitlistStatus {
  waiting
  notified
  claimed
  expired
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  password          String
  role              UserRole @default(user)
  gender            Gender?
  whatsappNumber    String?
  avatarUrl         String
  employeeId        String?
  loyaltyPoints     Int      @default(0)
  mustChangePassword Boolean @default(false)
  emailVerified     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bookings             Booking[]
  passwordResetTokens  PasswordResetToken[]
  verificationTokens   EmailVerificationToken[]
  deviceTokens         DeviceToken[]
  loyaltyTransactions  LoyaltyTransaction[]
  redemptions          RewardRedemption[]
  waitlistEntries      Waitlist[]
  reliability          UserReliability?
  refreshTokens        RefreshToken[]
  notifications        Notification[]
}

model Service {
  id              String         @id
  name            String
  category        String
  description     String
  longDescription String
  durationMinutes Int
  price           Float
  imageUrl        String
  featured        Boolean        @default(false)
  audience        ServiceAudience @default(unisex)

  employeeServices EmployeeService[]
  bookings         Booking[]
  loyaltyRewards   LoyaltyReward[]
  bookingServices  BookingService[]
  waitlist         Waitlist[]
}

model Employee {
  id              String  @id
  name            String
  email           String  @unique @default("")
  role            String
  gender          Gender?
  bio             String
  imageUrl        String
  rating          Float   @default(0)
  reviewCount     Int     @default(0)
  instagramHandle String?
  yearsExperience Int

  employeeServices      EmployeeService[]
  bookings              Booking[]
  weeklyAvailability    EmployeeAvailability[]
  availabilityOverrides AvailabilityOverride[]
  waitlistEntries       Waitlist[]
}

model EmployeeService {
  id         String  @id @default(cuid())
  serviceId  String
  employeeId String

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([serviceId, employeeId])
}

model Testimonial {
  id          String @id
  authorName  String
  avatarUrl   String
  rating      Int
  text        String
  service     String
  date        String
}

model Booking {
  id          String        @id @default(cuid())
  serviceId   String?
  employeeId  String?
  userId      String?
  date        DateTime
  timeSlot    String
  slotStart   String?
  slotEnd     String?
  name        String
  email       String
  phone       String
  notes       String?
  status      BookingStatus @default(pending)
  price       Float
  rating      Float?
  review      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  totalDurationMinutes Int?
  reminder24hSentAt    DateTime?
  reminder2hSentAt     DateTime?

  loyaltyTransactions LoyaltyTransaction[]
  rewardRedemptions  RewardRedemption[]
  bookingServices     BookingService[]
  notificationLogs    NotificationLog[]

  @@index([employeeId, date])
  @@index([userId])
  @@index([email])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  jti         String   @unique
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// Password reset tokens — only the SHA-256 hash of a random 32-byte token is
// stored; the raw token exists solely in the emailed reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email verification OTPs for signup (kept separate from reset tokens).
// Only the SHA-256 hash of the 6-digit code is stored.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, otpHash])
  @@index([userId])
}

model EmployeeAvailability {
  id         String   @id @default(cuid())
  employeeId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek, startTime])
  @@index([employeeId])
}

model AvailabilityOverride {
  id           String   @id @default(cuid())
  employeeId   String
  overrideDate DateTime
  startTime    String?
  endTime      String?
  isBlocked    Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, overrideDate, startTime])
}

// ─── Loyalty & Rewards ─────────────────────────────────────────────────────────

enum LoyaltyTransactionType {
  earn
  redeem
  adjust
  expire
  refund_reversal
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LoyaltyTransactionType
  points      Int
  balanceAfter Int
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  rewardRedemptionId String? @unique
  redemption  RewardRedemption? @relation(fields: [rewardRedemptionId], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([bookingId])
}

model LoyaltyReward {
  id          String   @id @default(cuid())
  name        String
  description String
  pointsCost  Int
  discountType String
  discountValue Float
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  stock       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions RewardRedemption[]
}

enum RedemptionStatus {
  active
  used
  expired
  cancelled
}

model RewardRedemption {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId    String
  reward      LoyaltyReward @relation(fields: [rewardId], references: [id])
  pointsSpent Int
  status      RedemptionStatus @default(active)
  code        String   @unique
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  usedAt      DateTime?
  expiresAt   DateTime?

  transaction LoyaltyTransaction?

  @@index([userId, status])
}

// ─── Audit Logs ──────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // e.g. "service_create", "booking_update", "employee_delete", "contact_form_submit"
  entityType  String   // e.g. "service", "booking", "employee", "user", "loyalty", "contact"
  entityId    String?  // ID of the affected record
  adminId     String?  // User ID of the admin who performed the action
  adminName   String?  // Display name of the admin
  adminEmail  String?  // Email of the admin
  details     String?  // JSON or text details about the change
  ip          String?  // Client IP address
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([adminId])
  @@index([createdAt])
}

// ─── Holidays ────────────────────────────────────────────────────────────────

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  type        String   // "public" | "festive" | "custom"
  isRecurring Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, name])
  @@index([date])
  @@index([type])
}

// ─── Waitlist ────────────────────────────────────────────────────────────────

model Waitlist {
  id          String         @id @default(cuid())
  userId      String
  employeeId  String
  slotStart   String         // "HH:MM" format
  slotEnd     String         // "HH:MM" format
  slotDate    DateTime?      // The date of the slot (YYYY-MM-DD), used for claim booking
  serviceId   String?        // single service for now; multi-service uses BookingService
  status      WaitlistStatus @default(waiting)
  createdAt   DateTime       @default(now())
  notifiedAt  DateTime?
  claimExpiresAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Declared as a relation so the column is actually constrained: without this
  // the field was a bare String? and deleting a service left waitlist rows
  // pointing at a service that no longer existed.
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([employeeId, slotStart, status])
  @@index([userId])
  @@index([status])
}

// ─── User Reliability ────────────────────────────────────────────────────────

model UserReliability {
  id              String    @id @default(cuid())
  userId          String    @unique
  cancelCount     Int       @default(0)
  lateCancelCount Int       @default(0) // cancels within 2 hours of slot
  noShowCount     Int       @default(0)
  restrictedUntil DateTime?
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Push notification devices ───────────────────────────────────────────────

model DeviceToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  platform   String    // "android" | "web"
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Notification delivery log (idempotency guard) ────────────────────────────
// One row per (booking, event, channel): a second notifyBooking() call for the
// same combination is a no-op.

/// In-app notification for a signed-in user — the bell in the header and the
/// /account/notifications page. Written alongside email and push, so a freed
/// slot, a confirmation or a reminder still reaches the user when email is not
/// configured at all (a bare RESEND_API_KEY absence used to mean the message
/// went nowhere).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// CONFIRMED | RESCHEDULED | CANCELLED | REMINDER_24H | REMINDER_6H | WAITLIST_SLOT_OPEN
  type      String
  title     String
  body      String
  deepLink  String?
  /// The booking that triggered it — absent for a waitlist cascade, which is
  /// about the slot rather than any booking the recipient owns.
  bookingId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model NotificationLog {
  id        String   @id @default(cuid())
  bookingId String
  event     String   // CONFIRMED | RESCHEDULED | CANCELLED | REMINDER_24H | REMINDER_6H | WAITLIST_SLOT_OPEN
  channel   String   // "email" | "push" | "in_app"
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, event, channel])
  @@index([bookingId])
}

// ─── System Settings ─────────────────────────────────────────────────────────
// Key-value store for admin-editable configuration.
// Env vars are the source of truth for secrets; this table stores
// non-sensitive operational settings that admins can change at runtime.

model SystemSetting {
  key         String   @id
  value       String   // JSON-stringified value or plain string
  description String?  // Human-readable description for the admin UI
  updatedAt   DateTime @updatedAt
  updatedBy   String?  // Admin userId who last changed this setting
}

// ─── Multi-service junction ──────────────────────────────────────────────────

model BookingService {
  id        String  @id @default(cuid())
  bookingId String
  serviceId String
  position  Int     @default(0) // ordering within the booking

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([bookingId, serviceId])
  @@index([bookingId])
}


