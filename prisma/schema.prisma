generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  guest
  user
  employee
  admin
}

enum Gender {
  male
  female
  other
}

enum BookingStatus {
  confirmed
  pending
  cancelled
  completed
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  password          String
  role              UserRole @default(user)
  gender            Gender?
  whatsappNumber    String?
  avatarUrl         String
  employeeId        String?
  loyaltyPoints     Int      @default(0)
  mustChangePassword Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bookings             Booking[]
  passwordResetTokens  PasswordResetToken[]
  loyaltyTransactions  LoyaltyTransaction[]
  redemptions          RewardRedemption[]
}

model Service {
  id              String         @id
  name            String
  category        String
  description     String
  longDescription String
  durationMinutes Int
  price           Float
  imageUrl        String
  featured        Boolean        @default(false)

  employeeServices EmployeeService[]
  bookings         Booking[]
  loyaltyRewards   LoyaltyReward[]
}

model Employee {
  id              String  @id
  name            String
  email           String  @unique @default("")
  role            String
  gender          Gender?
  bio             String
  imageUrl        String
  rating          Float   @default(0)
  reviewCount     Int     @default(0)
  instagramHandle String?
  yearsExperience Int

  employeeServices      EmployeeService[]
  bookings              Booking[]
  weeklyAvailability    EmployeeAvailability[]
  availabilityOverrides AvailabilityOverride[]
}

model EmployeeService {
  id         String  @id @default(cuid())
  serviceId  String
  employeeId String

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([serviceId, employeeId])
}

model Testimonial {
  id          String @id
  authorName  String
  avatarUrl   String
  rating      Int
  text        String
  service     String
  date        String
}

model Booking {
  id          String        @id @default(cuid())
  serviceId   String?
  employeeId  String?
  userId      String?
  date        DateTime
  timeSlot    String
  slotStart   String?
  slotEnd     String?
  name        String
  email       String
  phone       String
  notes       String?
  status      BookingStatus @default(pending)
  price       Float
  rating      Int?
  review      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  loyaltyTransactions LoyaltyTransaction[]
  rewardRedemptions  RewardRedemption[]

  @@index([employeeId, date])
  @@index([userId])
  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Uniqueness is scoped per user so two different users can share a 6-digit OTP
  // without violating the constraint (prevents 500 on forgot-password).
  @@unique([userId, token])
  @@index([userId])
}

model EmployeeAvailability {
  id         String   @id @default(cuid())
  employeeId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek, startTime])
  @@index([employeeId])
}

model AvailabilityOverride {
  id           String   @id @default(cuid())
  employeeId   String
  overrideDate DateTime
  startTime    String?
  endTime      String?
  isBlocked    Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, overrideDate, startTime])
}

// ─── Loyalty & Rewards ─────────────────────────────────────────────────────────

enum LoyaltyTransactionType {
  earn
  redeem
  adjust
  expire
  refund_reversal
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LoyaltyTransactionType
  points      Int
  balanceAfter Int
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  rewardRedemptionId String? @unique
  redemption  RewardRedemption? @relation(fields: [rewardRedemptionId], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([bookingId])
}

model LoyaltyReward {
  id          String   @id @default(cuid())
  name        String
  description String
  pointsCost  Int
  discountType String
  discountValue Float
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  stock       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions RewardRedemption[]
}

enum RedemptionStatus {
  active
  used
  expired
  cancelled
}

model RewardRedemption {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId    String
  reward      LoyaltyReward @relation(fields: [rewardId], references: [id])
  pointsSpent Int
  status      RedemptionStatus @default(active)
  code        String   @unique
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  usedAt      DateTime?
  expiresAt   DateTime?

  transaction LoyaltyTransaction?

  @@index([userId, status])
}

// ─── Audit Logs ──────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // e.g. "service_create", "booking_update", "employee_delete", "contact_form_submit"
  entityType  String   // e.g. "service", "booking", "employee", "user", "loyalty", "contact"
  entityId    String?  // ID of the affected record
  adminId     String?  // User ID of the admin who performed the action
  adminName   String?  // Display name of the admin
  adminEmail  String?  // Email of the admin
  details     String?  // JSON or text details about the change
  ip          String?  // Client IP address
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([adminId])
  @@index([createdAt])
}

// ─── Holidays ────────────────────────────────────────────────────────────────

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  type        String   // "public" | "festive" | "custom"
  isRecurring Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, name])
  @@index([date])
  @@index([type])
}


