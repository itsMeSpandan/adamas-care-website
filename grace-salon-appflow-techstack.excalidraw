      "roundness": null,
      "seed": 67,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2. Waitlist: Slot full → Join Waitlist (ranked by scoring) → Cancellation frees slot → Offer to top → Claim within expiry",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "2. Waitlist: Slot full → Join Waitlist (ranked by scoring) → Cancellation frees slot → Offer to top → Claim within expiry",
      "lineHeight": 1.2
    },
