      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1. Guest Booking: Browse → Select Service/Employee → Check Availability → Book (creates Booking) → Confirmation Email/Notification",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "1. Guest Booking: Browse → Select Service/Employee → Check Availability → Book (creates Booking) → Confirmation Email/Notification",
      "lineHeight": 1.2
    },
    {
      "id": "flow2",
      "type": "text",
      "x": 100,
      "y": 780,
      "width": 600,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
