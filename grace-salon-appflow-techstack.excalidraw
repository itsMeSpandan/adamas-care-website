    {
      "id": "flow1",
      "type": "text",
      "x": 100,
      "y": 750,
      "width": 600,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
