[TEMPLATE]
[TEMPLATE]
# Database (Prisma / NeonDB)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Base URL (used for password reset links, etc.)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# JWT signing secret — REQUIRED. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Upstash Redis — for distributed rate limiting across serverless instances.
# Get free tier at https://upstash.com. Falls back to in-memory when not set.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email — Resend (used for transactional emails: booking confirmations, reminders)
RESEND_API_KEY=""
EMAIL_FROM=""

# Email — EmailJS (used for OTP password reset)
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
EMAILJS_SERVICE_ID=""
EMAILJS_OTP_TEMPLATE_ID=""

# WhatsApp Cloud API (for booking confirmation messages)
# See WHATSAPP_SETUP.md for manual Meta Business setup steps.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME=""

# Sentry — error tracking and performance monitoring.
# Get DSN at https://sentry.io → Settings → Projects → Client Keys.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
