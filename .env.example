# ─── Database (Prisma / PostgreSQL) ─────────────────────────────────────────────
# Required. Connection string for your Postgres database.
DATABASE_URL="postgresql://user:password@localhost:5432/adamas_care?schema=public"

# ─── JWT Signing Secret ──────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -base64 48
SESSION_SECRET="your-secret-key-at-least-32-chars"

# ─── EmailJS (OTP Emails for Password Reset) ─────────────────────────────────────
# Optional. If not configured, OTP will only be logged to console (dev mode).
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
EMAILJS_SERVICE_ID=""
EMAILJS_OTP_TEMPLATE_ID=""

# ─── CORS ────────────────────────────────────────────────────────────────────────
# Optional. Comma-separated origins or "*" for all. Defaults to "*".
CORS_ORIGINS="*"
