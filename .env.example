# Database (Prisma / NeonDB)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Base URL (used for password reset links, etc.)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# JWT signing secret — REQUIRED. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Upstash Redis — for distributed rate limiting across serverless instances.
# Get free tier at https://upstash.com. Falls back to in-memory when not set.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email — Resend (transactional emails: booking confirmations, reminders,
# password reset links, signup verification codes)
RESEND_API_KEY=""
EMAIL_FROM=""

# Firebase Cloud Messaging — web/app push notifications.
# NEXT_PUBLIC_* values are safe (by design) to expose to the browser.
# FIREBASE_PRIVATE_KEY: paste the PKCS#8 PEM with real newlines OR "\n" escapes.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Sentry — error tracking and performance monitoring.
# Get DSN at https://sentry.io → Settings → Projects → Client Keys.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
