# Database (Prisma / NeonDB)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Base URL (used for password reset links, etc.)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# JWT signing secret — REQUIRED. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Email — Resend (legacy, can be removed if fully migrated to EmailJS)
RESEND_API_KEY=""
EMAIL_FROM=""

# Email — EmailJS (used for OTP password reset)
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
EMAILJS_SERVICE_ID=""
EMAILJS_OTP_TEMPLATE_ID=""
